# ============================================================================
# PROP FIRM TRADING PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copia este archivo como .env para desarrollo local o despliegue en VPS
# ============================================================================

# ----------------------------------------------------------------------------
# 0. IDENTIDAD Y MARCA BLANCA (CAMBIAR AQUÍ PARA OTRA EMPRESA)
# ----------------------------------------------------------------------------
VITE_APP_NAME=Eklipse Funded
VITE_APP_SHORT_NAME=Eklipse
VITE_SUPPORT_EMAIL=soporte@eklipsefunded.com

# ----------------------------------------------------------------------------
# 1. PUERTOS DE HOST (Configurables para evitar colisiones)
# ----------------------------------------------------------------------------
PORT_DB=5432
PORT_REDIS=6379
PORT_SUPABASE=54321
PORT_SERVER=8088
PORT_WEB=3180

# ----------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL 16
# ----------------------------------------------------------------------------
POSTGRES_DB=eklipse_funded
POSTGRES_USER=eklipse_admin
POSTGRES_PASSWORD=eklipse_secret_pass_local
DATABASE_URL=postgresql://eklipse_admin:eklipse_secret_pass_local@localhost:5432/eklipse_funded

# ----------------------------------------------------------------------------
# 3. REDIS IN-MEMORY HOT STATE & PUB/SUB
# ----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------------------
# 4. SUPABASE / POSTGREST LOCAL ENGINE (Paridad 1:1 con Cloud)
# ----------------------------------------------------------------------------
# Para usar Supabase local (Docker):
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eklipse_jwt_secret_super_secure_institutional_32bytes_min

# Para conectar alternativamente con Supabase Cloud:
# VITE_SUPABASE_URL=https://ujcnglkdwzqlwqgrkspz.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_Vg2Hc-cvEpBj0TKBXB3Tmw_1PCxN9C0

# ----------------------------------------------------------------------------
# 5. WEBSOCKET & SERVIDOR DE TRADING PRE-TRADE RISK
# ----------------------------------------------------------------------------
VITE_WS_GATEWAY_URL=ws://localhost:8088
JWT_SECRET=eklipse_jwt_secret_super_secure_institutional_32bytes_min

# ----------------------------------------------------------------------------
# 6. RESEND EMAIL DELIVERY API
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdef
VITE_RESEND_API_KEY=re_123456789_abcdef
RESEND_FROM_EMAIL=soporte@eklipsefunded.com

# ----------------------------------------------------------------------------
# 7. SUPABASE AUTH ENGINE (GOTRUE) & OAUTH SOCIAL LOGIN
# ----------------------------------------------------------------------------
PORT_AUTH=9999
API_EXTERNAL_URL=http://localhost:54321
GOTRUE_SITE_URL=http://localhost:3100
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false

# Google OAuth (Obtener en Google Cloud Console -> APIs & Services -> Credentials)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=http://localhost:54321/auth/v1/callback

